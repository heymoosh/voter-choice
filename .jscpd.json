{
  "threshold": 0,
  "reporters": ["json"],
  "output": ".jscpd-report",
  "pattern": "{src,e2e/helpers,scripts/design}/**/*.{ts,tsx}",
  "ignore": [
    "docs/archive/**",
    "node_modules",
    ".next",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "minLines": 5,
  "minTokens": 50
}
