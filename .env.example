ANTHROPIC_VOTER_API=
GOOGLE_CIVIC_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Congress.gov API — used by scripts/ingest/federal-votes.ts (bill enrichment)
# and scripts/ingest/crs-summaries.ts (CRS plain-language bill summaries).
# Get a free key at https://api.congress.gov/sign-up (api.data.gov).
# Rate limit: ~5,000 req/hr authenticated (30 req/hr without key).
# Without this key the enrichment + CRS-summary steps are silently skipped.
# Public domain data — no attribution required in the UI.
CONGRESS_GOV_API_KEY=
# Override the base URL (defaults to https://api.congress.gov/v3 in the scripts).
# Set this in tests/CI to point at a mock server.
CONGRESS_GOV_BASE_URL=
# Override the GovTrack base URL (defaults to https://www.govtrack.us/api/v2).
GOVTRACK_BASE_URL=

# Experience flag (build-time): "true" = legacy ballot-centric experience
# (civic contests + ballot upload). Unset/anything else = the congress-
# assessment experience (address → delegation → assess) — the prod default.
NEXT_PUBLIC_BALLOT_ENABLED=

# Server-side: set to any non-empty value to surface CAN2026 curated context
# (race ratings / donor trail / key votes) on the seat cards. Leave UNSET until
# can2026.org attribution terms are confirmed with the maintainer. Default OFF.
CAN2026_DISPLAY_ENABLED=

# Server-side: set to exactly "true" to surface the Part 6 money-transparency
# blocks on the seat cards — "Top PACs and their sponsors" (6a) and "Outside
# spending about this race" (6b). Both read hand-curatable sponsor
# attributions (pac_committees.status). FLIPPED LIVE in prod 2026-08-16 (the
# 6b ingest run + 30-committee curation pass both cleared) — this default
# stays UNSET here only because local/dev envs should opt in deliberately.
PAC_TRANSPARENCY_ENABLED=

# Server-side: set to exactly "true" to surface Part 5 promise-ledger
# kept/broken verdicts. Leave UNSET until the rubric §6.4 ship gate clears
# (independent two-annotator gold pass, κ >= 0.70, >= 90% adjudicator
# agreement, zero kept<->broken polarity flips — scripts/ingest/
# _promise-gold-score.ts) AND Muxin signs off regardless of the numbers.
# Default OFF.
PROMISE_TRACKER_ENABLED=

# Server-side: set to exactly "true" to surface billionaire_donor_contributions
# (itemized FEC donor records matched against the hand-verified
# BILLIONAIRE_SEED list, scripts/ingest/_billionaire-seed.ts). Leave UNSET —
# low-confidence matches (name match, contradicting employer) need a human
# review pass, and no UI decision has been made yet either (separate Claude
# Design session). Default OFF.
BILLIONAIRE_DONOR_MATCH_ENABLED=

# Server-side kill-switch: set to "true" to persist anonymous voter issue-
# preference event rows (state + issue + stance only; no identifier, no
# address, no verbatim text) to Postgres at session-end. Requires DATABASE_URL.
# Leave UNSET until the privacy-policy update is live. Default OFF.
VOTER_ISSUE_EVENTS_ENABLED=

# Optional durable/shared safeguards for production. Vercel KV and Upstash Redis
# expose these REST variables. If omitted, the app falls back to process-local
# counters suitable for local development only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative Upstash names are also supported:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used only by scripts/provision-durable-safeguards.sh. Do not commit real
# values; pass them interactively or through your local shell.
UPSTASH_EMAIL=
UPSTASH_API_KEY=
UPSTASH_REGION=us-west-1
UPSTASH_PRIMARY_REGION=us-west-1
UPSTASH_DATABASE_NAME=voter-choice-launch-safeguards
USE_EXISTING_UPSTASH_REDIS=

# Optional server-side abuse controls. Defaults are set for launch, but can be
# tuned in Vercel/GitHub secrets without code changes.
CHAT_CONCURRENT_SESSION_LIMIT=10
CHAT_DAILY_SESSION_LIMIT=10

# Client-side (build-time inlined): set to exactly "true" to enable the
# dev-only on-device-AI (WebLLM) comparison surface — the /dev/on-device-ai
# page and its /api/dev/theme-extraction-compare reference API route. Both
# 404 when unset. Internal spike/eval tool only, no voter-facing behavior.
# Default OFF.
NEXT_PUBLIC_LAUNCH_ON_DEVICE_AI=
