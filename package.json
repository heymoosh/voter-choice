{
  "name": "voter-choice",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "rm -rf .next/cache && npm run sync:ballot-prompt",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run sync:ballot-prompt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "measure": "node scripts/measure.mjs",
    "sync:ballot-prompt": "node scripts/generate-ballot-prompt-module.mjs",
    "clean-start": "rm -rf node_modules .next coverage .jscpd-report .lighthouseci .vitest-report.json .eslint-report.json playwright-report.json && npm install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:smoke": "npx tsx scripts/ingest/_smoke.ts",
    "db:tag-bills": "npx tsx scripts/ingest/tag-bills.ts",
    "db:candidates-federal": "npx tsx scripts/ingest/federal-candidates.ts --year 2026",
    "verify:congressional-calendar": "npx tsx scripts/ingest/congressional-calendar.ts",
    "db:donors-federal": "npx tsx scripts/ingest/federal-donors.ts",
    "db:donors-state": "npx tsx scripts/ingest/state-donors.ts",
    "db:member-stats": "npx tsx scripts/ingest/member-stats.ts",
    "db:audit-tags": "npx tsx scripts/ingest/_audit-tags.ts",
    "db:retag-selector": "npx tsx scripts/ingest/_retag-selector.ts",
    "db:retag-gold-check": "npx tsx scripts/ingest/_retag-gold-check.ts",
    "db:analytics-concerns": "npx tsx scripts/analytics/voter-concerns.ts",
    "design:parity-gallery": "npx tsx scripts/design/parity-gallery.ts",
    "design:parity-gate": "npx tsx scripts/design/parity-gate.ts",
    "design:review-gallery": "npx tsx scripts/design/review-gallery.ts",
    "design:gate-summary": "npx tsx scripts/design/gate-summary.ts",
    "dup:check": "npx tsx scripts/quality/duplication-gate.ts",
    "dup:baseline": "npx tsx scripts/quality/duplication-gate.ts --update",
    "inventory:check": "npx tsx scripts/quality/component-inventory-gate.ts",
    "verify:congressional-source-inventory": "npx tsx scripts/verify-congressional-source-inventory.ts",
    "verify:f03-congressional-source-inventory": "npx tsx scripts/verify-f03-congressional-source-inventory.ts",
    "verify:i06-congressional-source-inventory": "npx tsx scripts/verify-i06-congressional-source-inventory.ts",
    "verify:i11-congressional-source-inventory": "npx tsx scripts/verify-i11-congressional-source-inventory.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@aws-sdk/client-textract": "3.1055.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@googlemaps/js-api-loader": "2.0.2",
    "@napi-rs/canvas": "1.0.2",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "next": "15.5.20",
    "pdfjs-dist": "5.7.284",
    "pixelmatch": "7.2.0",
    "react": "19.1.0",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@lhci/cli": "0.15.0",
    "@playwright/test": "1.61.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.37",
    "@types/pg": "8.11.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "3.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-complexity": "1.0.2",
    "eslint-plugin-prettier": "5.4.1",
    "jscpd": "4.0.5",
    "jsdom": "25.0.1",
    "pg": "8.20.0",
    "prettier": "3.5.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.1"
  }
}
