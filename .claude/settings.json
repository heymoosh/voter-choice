{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "Bash(git branch -D board-sync/*)",
      "Bash(git push origin --delete board-sync/*)",
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run check)",
      "Bash(npm run dup:check)",
      "Bash(npm run inventory:check)",
      "Bash(npm run build)",
      "Bash(npm run e2e)",
      "Bash(npm run sync:ballot-prompt)",
      "Bash(npm run design:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright install --with-deps chromium)",
      "Bash(npx tsc:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
