# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# measurement artifacts
.eslint-report.json
.vitest-report.json
.jscpd-report/
.lighthouseci/
playwright-report.json
test-results/
.playwright-browsers/
.playwright-cli/

# Keystone parity-gallery run artifacts (screenshots + generated index.html) —
# regenerate with `npm run design:parity-gallery`, never commit the output.
scripts/design/.parity-gallery-out/

# Keystone parity-gate run artifacts (screenshots + diff PNGs + report.json) —
# regenerate with `npm run design:parity-gate`, never commit the output.
scripts/design/.parity-gate-out/

# AI Coding Practices local tool state
.agentic-qe/
.ai/local-pdfs/
.ai/extracted-ballots/

# Generated by the local prose-kanban board server.
docs/operations/*.lock

# Stryker mutation testing (reports + working dir)
reports/
.stryker-tmp/

# Drizzle Kit journal / meta (generated, not committed)
db/migrations/meta/

# local QA scratch (ballot images, venv, harness output) — never deploy/commit
.scratch-ballot/

# Alignment re-tag working data (ephemeral batch + result files; tags live on the Neon branch)
scripts/ingest/_pole-batches/

# Sub-issue re-tag + gold working data (ephemeral; sub_issue tags live on the DB)
scripts/ingest/_subissue-batches/
scripts/ingest/_subissue-gold/

# Cutover gold-sample: ignore bulky reproducible intermediates (batch inputs, juror files,
# prod backup dumps); KEEP the audit evidence (_manifest / _gold-consensus / _gold-disagreements
# / _gold-pv), which do not match the batch-id pattern below.
scripts/ingest/_gold-batches/*-[0-9][0-9][0-9].json
scripts/ingest/_gold-batches/_results/
scripts/ingest/_cutover-backup-*.json

# Local debug / scratch artifacts (Playwright MCP downloads, DB dumps, root-level
# debug screenshots, tool state) — never commit. NOTE: /*.png is anchored to the
# repo root so tracked reference shots under docs/UI_REFERENCE/ are kept.
.playwright-mcp/
*.pgdump
/*.png
.eslint-complexity-report.json
.claire/
.claude/scheduled_tasks.lock
_alignment-review/
